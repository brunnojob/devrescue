{
  "name": "@brunnodev/devrescue",
  "version": "0.1.0",
  "description": "Local-first developer troubleshooting: evidence, reviewed fixes and CI summaries",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
