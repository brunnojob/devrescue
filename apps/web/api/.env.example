# Set privately in Azure App Service Configuration. Do not put these in a VITE_* variable.
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@rg-db-wallmarket.postgres.database.azure.com:5432/EXISTING_DATABASE
PUBLIC_SITE_URL=https://brunnojob.github.io/devrescue/
API_ORIGIN=https://YOUR-EXISTING-API.azurewebsites.net
GITHUB_CLIENT_ID=YOUR_OAUTH_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_OAUTH_APP_CLIENT_SECRET
# A base64-encoded 32-byte key. Preserve the existing key for existing encrypted records.
TOKEN_ENCRYPTION_KEY=YOUR_EXISTING_BASE64_KEY
# PGSSLROOTCERT_PEM is optional if the runtime already trusts Azure's CA.
PORT=8787
